# Learning-System environment template.
# Do not put real API keys, database passwords, session secrets, or local private paths in this file.

# Used in phase 1 by README examples.
APP_URL=http://localhost:3000
NODE_ENV=development

# Required from phase 2 for Drizzle migrations and /api/health/db.
# Use a real PostgreSQL connection string in .env.local; keep this template non-sensitive.
DATABASE_URL=postgres://learning:learning@postgres:5432/learning

# Reserved for later BullMQ/Redis integration; unused in phase 1.
REDIS_URL=redis://redis:6379

# Reserved for later authentication; unused in phase 1.
SESSION_SECRET=replace-me-with-a-random-secret

# Reserved for later file storage; unused in phase 1.
UPLOADS_DIR=/data/uploads
EXPORTS_DIR=/data/exports
BACKUPS_DIR=/data/backups
MAX_UPLOAD_MB=1024

# Optional from phase 2. Configure one of these in .env.local when the server
# should validate a local Markdown knowledge base root. Keep real local paths
# out of this template and out of committed files.
KNOWLEDGE_BASE_DIR=
VAULT_ROOT=

# Reserved for later AI provider settings; unused in phase 1.
# Configure real keys in the application settings page once that feature exists.
AI_BASE_URL=
AI_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_MODEL=
VISION_BASE_URL=
VISION_MODEL=
